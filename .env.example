# Prefer: mint from GitBrain dashboard (signup → Tokens), then paste here.
# Never commit a real token. Never put the token inside a chat prompt.
GB_TOKEN=gb_host_replace_me

# Prefer the public MCP hostname
GB_MCP_URL=https://mcp.gitbrain.com/mcp
GB_REST_URL=https://mcp.gitbrain.com

# Site (management + wiki) — target product URLs
GB_SITE_URL=https://gitbrain.com
GB_APP_URL=https://app.gitbrain.com
