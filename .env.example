# Mint from https://app.gitbrain.com/dashboard (or /authorize-agent).
# Dashboard tokens are prefixed gb_live_… — paste into the host secret store as GB_TOKEN.
# Ops host/service tokens are a separate class. Never commit a real token. Never put it in a prompt.
GB_TOKEN=gb_live_replace_me

# Prefer the public MCP hostname
GB_MCP_URL=https://mcp.gitbrain.com/mcp
GB_REST_URL=https://mcp.gitbrain.com

# Human app (signup, dashboard, wiki, authorize-agent) — not https://gitbrain.com
GB_APP_URL=https://app.gitbrain.com
